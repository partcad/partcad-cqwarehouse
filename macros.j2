{%- macro list_sizes(all_sizes, available_sizes) -%}
{%- for num in all_sizes -%}
{%- if num in available_sizes -%}
- "{{ all_sizes[num] }}"
{% endif -%}
{%- endfor -%}
{%- endmacro -%}

{%- macro screw_params(all_sizes, available_sizes) -%}
      size:
        type: string
        enum:
          {{ list_sizes(all_sizes, available_sizes) | indent(10) }}
        default: "{{ all_sizes[available_sizes[0]] }}"
      simple:
        type: bool
        default: False
      length:
        # Not an integer: a screw 3.5mm long is a catalogue item, as are 4.5,
        # 6.5 and 12.5, and the sizes beside it are already fractional - M2.5,
        # M3.5. cq_warehouse takes a float here, and PartCAD checks the
        # declared type as of 0.8.85, so an integer here refuses the length
        # somebody actually has.
        type: float
        default: 10
      hand:
        type: string
        enum: ["left","right"]
        default: right
{%- endmacro -%}

{%- macro screw_params2(sizes) -%}
      size:
        type: string
        enum: {{ sizes }}
        default: "{{ sizes[0] }}"
      simple:
        type: bool
        default: False
      length:
        # Not an integer: a screw 3.5mm long is a catalogue item, as are 4.5,
        # 6.5 and 12.5, and the sizes beside it are already fractional - M2.5,
        # M3.5. cq_warehouse takes a float here, and PartCAD checks the
        # declared type as of 0.8.85, so an integer here refuses the length
        # somebody actually has.
        type: float
        default: 10
      hand:
        type: string
        enum: ["left","right"]
        default: right
{%- endmacro -%}

{#- A nut takes a thread, like a screw, and has no length. -#}
{%- macro nut_params(all_sizes, available_sizes) -%}
      size:
        type: string
        enum:
          {{ list_sizes(all_sizes, available_sizes) | indent(10) }}
        default: "{{ all_sizes[available_sizes[0]] }}"
      simple:
        type: bool
        default: False
      hand:
        type: string
        enum: ["left","right"]
        default: right
{%- endmacro -%}

{#- A washer is named by the screw it takes, without a pitch: "M6". -#}
{%- macro list_washer_sizes(all_sizes, available_sizes) -%}
{%- for num in all_sizes -%}
{%- if num in available_sizes -%}
- "{{ all_sizes[num].split('-')[0] }}"
{% endif -%}
{%- endfor -%}
{%- endmacro -%}

{%- macro washer_params(all_sizes, available_sizes) -%}
      size:
        type: string
        enum:
          {{ list_washer_sizes(all_sizes, available_sizes) | indent(10) }}
        default: "{{ all_sizes[available_sizes[0]].split('-')[0] }}"
{%- endmacro -%}
